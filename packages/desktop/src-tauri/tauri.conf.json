{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "navvied",
  "version": "0.3.1",
  "identifier": "com.navvied.desktop",
  "build": { "frontendDist": "../shell-pages" },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "An AI helper for your files and code",
    "longDescription": "navvied works on the folder you choose and asks before it changes anything. The model can run on your own computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/navvied"],
    "macOS": { "minimumSystemVersion": "11.0", "hardenedRuntime": true, "entitlements": "entitlements.plist" },
    "windows": { "webviewInstallMode": { "type": "embedBootstrapper" }, "nsis": { "installMode": "currentUser", "displayLanguageSelector": false } },
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"] } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["navvied"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNEUzRTg0NzE2NzRBQzUKUldURlNtZHhoRDVPLzdUdzNtcTJ5L3BYb1Exa2tSVVp6VWIyMUpGZEcyeElKd1ZUZkppaFNOSkYK",
      "endpoint": ["https://github.com/navvied/navvied-agent/releases/latest/download/latest.json"]
    }
  }
}

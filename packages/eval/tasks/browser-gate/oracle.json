[
  {
    "tool": "Bash",
    "args": {
      "command": "cat .bench-port"
    }
  },
  {
    "tool": "Browser",
    "args": {
      "action": "open",
      "url": "http://127.0.0.1:${result:(\\d+)}/gate"
    }
  },
  {
    "tool": "Write",
    "args": {
      "file_path": "ANSWER.txt",
      "content": "${result:(The person was asked[^\\n]*)}\n"
    }
  }
]

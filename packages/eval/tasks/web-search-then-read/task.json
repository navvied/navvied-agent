{
  "id": "web-search-then-read",
  "title": "Search, pick the right result and read it",
  "kind": "web",
  "level": 2,
  "lang": "none",
  "requires": [
    "bash",
    "bun"
  ],
  "prompt": "Use WebSearch to find the current release code of Project Falcon, read the page that has it, and write only the code into ANSWER.txt.",
  "check": "bun \"$BENCH_FIXTURES/web-check.ts\" search-then-read",
  "protect": [
    "README.md"
  ],
  "maxSteps": 20,
  "timeoutSeconds": 600,
  "setup": "bun \"$BENCH_FIXTURES/start-web.ts\" && echo \"http://127.0.0.1:$(cat .bench-port)\" > docs-url.txt",
  "teardown": "bun \"$BENCH_FIXTURES/stop-web.ts\"",
  "env": {
    "NAVVIED_ALLOW_PRIVATE_NETWORK": "1",
    "NAVVIED_SEARCH_URL": "http://127.0.0.1:{port}/search"
  }
}

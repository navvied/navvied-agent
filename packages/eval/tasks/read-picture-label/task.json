{
  "id": "read-picture-label",
  "title": "Read the label of a picture",
  "kind": "terminal",
  "level": 1,
  "lang": "none",
  "requires": [
    "bun"
  ],
  "media": [
    "vision"
  ],
  "prompt": "chart.png is a picture with a label on it. Write the text of the label into answer.txt.",
  "check": "grep -qiE 'revenue ?42' answer.txt",
  "protect": [
    "README.md"
  ],
  "maxSteps": 30,
  "timeoutSeconds": 600,
  "setup": "bun \"$BENCH_FIXTURES/make-chart.ts\" chart.png"
}
